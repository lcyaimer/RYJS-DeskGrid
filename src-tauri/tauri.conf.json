{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RYJS DeskGrid",
  "version": "0.2.6",
  "identifier": "com.lcyaimer.ryjsdeskgrid",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RYJS DeskGrid",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "focus": false,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "shadow": false,
        "zoomHotkeysEnabled": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data: blob: https: http:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "lcyaimer",
    "homepage": "https://github.com/lcyaimer/RYJS-DeskGrid",
    "copyright": "Copyright © 2026 lcyaimer",
    "category": "Utility",
    "shortDescription": "轻盈透明的桌面收纳工具",
    "longDescription": "RYJS DeskGrid 把本机文件、软件快捷方式与网页书签收进可自由摆放的半透明分类卡片中。支持自定义分类、透明度、浏览器书签导入与密码隐私锁，窗口常驻系统托盘。",
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
